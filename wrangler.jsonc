{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ls",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dj-tz-db",
      "database_id": "4c6248e0-2403-4d5d-acc2-7df807db14b9",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ls-dj-tz.cloudflareaccess.com",
    "ACCESS_AUD": "36d1115dc93db11abb7cce7028a17016c32ad66d06221cd5bae252c53e3ef592"
  }
}
